<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light theme: its own palette with the same structure as dark, not an inversion.
         Every text/background pair is at or above 4.5:1 (secondary text 5.4:1, accent text 5.6:1, error 6.1:1). -->
    <SolidColorBrush x:Key="Brush.Panel" Color="#F9FAFB" />
    <!-- The content layer: same as the panel when solid; translucent over glass so the backdrop shows only as a hint behind text. -->
    <SolidColorBrush x:Key="Brush.ContentLayer" Color="#F9FAFB" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#EFF1F3" />
    <SolidColorBrush x:Key="Brush.Well" Color="#FFFFFF" />
    <!-- 2.0 Mail list: one tone off the window so the list has edges (white in light, a shade deeper in dark) -->
    <SolidColorBrush x:Key="Brush.ListSurface" Color="#FFFFFF" />
    <!-- Theme pass: the reading-pane card reads as paper — a touch warmer than the cool panel -->
    <SolidColorBrush x:Key="Brush.Paper" Color="#FCFBF7" />
    <SolidColorBrush x:Key="Brush.Hairline" Color="#E1E5E8" />
    <SolidColorBrush x:Key="Brush.ControlBorder" Color="#C5CCD2" />
    <SolidColorBrush x:Key="Brush.Text" Color="#1F2429" />
    <SolidColorBrush x:Key="Brush.Body" Color="#2B3239" />
    <SolidColorBrush x:Key="Brush.Secondary" Color="#5F6A74" />
    <SolidColorBrush x:Key="Brush.ChipText" Color="#343C44" />
    <!-- Amber stays the one accent: fills keep the hue; text in the accent is darkened to reach contrast. -->
    <SolidColorBrush x:Key="Brush.Accent" Color="#E8A93A" />
    <SolidColorBrush x:Key="Brush.AccentText" Color="#8A5A00" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#F0B54F" />
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#D3982F" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#1E2328" />
    <SolidColorBrush x:Key="Brush.AccentSurface" Color="#FBF0D8" />
    <SolidColorBrush x:Key="Brush.OnAccentSurface" Color="#5C3D00" />
    <!-- Messages module: iMessage blue, SMS green, grey for the other side (stage 7). -->
    <SolidColorBrush x:Key="Brush.BubbleMe" Color="#1982FC" />
    <SolidColorBrush x:Key="Brush.BubbleSms" Color="#34C759" />
    <SolidColorBrush x:Key="Brush.OnBubbleMe" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.BubbleThem" Color="#E9E9EB" />
    <SolidColorBrush x:Key="Brush.OnBubbleThem" Color="#1A1F24" />
    <SolidColorBrush x:Key="Brush.ReactionPill" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Connected" Color="#1F7A4D" />
    <SolidColorBrush x:Key="Brush.Error" Color="#B3261E" />
    <SolidColorBrush x:Key="Brush.HoverOverlay" Color="#0A000000" />
    <SolidColorBrush x:Key="Brush.PressedOverlay" Color="#14000000" />
    <SolidColorBrush x:Key="Brush.ScrollThumb" Color="#665B6670" />
    <Color x:Key="Color.Shadow">#000000</Color>
    <!-- Glass overlay colors (Themes/Glass.xaml reads these when Material is Mica or Acrylic). -->
    <Color x:Key="Glass.SurfaceColor">#B3FFFFFF</Color>
    <Color x:Key="Glass.ContentColor">#BFF5F7FA</Color>
    <Color x:Key="Glass.WellColor">#80FFFFFF</Color>
    <Color x:Key="Glass.HairlineColor">#22000000</Color>
    <Color x:Key="Glass.EdgeTopColor">#E6FFFFFF</Color>
    <Color x:Key="Glass.EdgeBottomColor">#33000000</Color>
</ResourceDictionary>
