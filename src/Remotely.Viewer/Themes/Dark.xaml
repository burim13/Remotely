<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark theme. Values from the design table in the build brief. -->
    <SolidColorBrush x:Key="Brush.Panel" Color="#1C2127" />
    <!-- The content layer: same as the panel when solid; translucent over glass so the backdrop shows only as a hint behind text. -->
    <SolidColorBrush x:Key="Brush.ContentLayer" Color="#1C2127" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#2B3239" />
    <SolidColorBrush x:Key="Brush.Well" Color="#161A1E" />
    <!-- 2.0 Mail list: one tone off the window so the list has edges (white in light, a shade deeper in dark) -->
    <SolidColorBrush x:Key="Brush.ListSurface" Color="#21272D" />
    <SolidColorBrush x:Key="Brush.Paper" Color="#2A3138" />
    <SolidColorBrush x:Key="Brush.Hairline" Color="#303840" />
    <SolidColorBrush x:Key="Brush.ControlBorder" Color="#3F4851" />
    <SolidColorBrush x:Key="Brush.Text" Color="#F2F4F5" />
    <SolidColorBrush x:Key="Brush.Body" Color="#E4E8EA" />
    <SolidColorBrush x:Key="Brush.Secondary" Color="#A9B3BA" />
    <SolidColorBrush x:Key="Brush.ChipText" Color="#D6DBDF" />
    <SolidColorBrush x:Key="Brush.Accent" Color="#F7BE55" />
    <SolidColorBrush x:Key="Brush.AccentText" Color="#F7BE55" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#F9CB74" />
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#E2A93B" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#1E2328" />
    <SolidColorBrush x:Key="Brush.AccentSurface" Color="#3E3524" />
    <SolidColorBrush x:Key="Brush.OnAccentSurface" Color="#F2E3BF" />
    <!-- Messages module bubbles (stage 7). -->
    <SolidColorBrush x:Key="Brush.BubbleMe" Color="#0A84FF" />
    <SolidColorBrush x:Key="Brush.BubbleSms" Color="#30D158" />
    <SolidColorBrush x:Key="Brush.OnBubbleMe" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.BubbleThem" Color="#3B3B3D" />
    <SolidColorBrush x:Key="Brush.OnBubbleThem" Color="#F2F2F7" />
    <SolidColorBrush x:Key="Brush.ReactionPill" Color="#2C2C2E" />
    <SolidColorBrush x:Key="Brush.Connected" Color="#6FCF97" />
    <SolidColorBrush x:Key="Brush.Error" Color="#FF9B8A" />
    <SolidColorBrush x:Key="Brush.HoverOverlay" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="Brush.PressedOverlay" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="Brush.ScrollThumb" Color="#66A9B3BA" />
    <Color x:Key="Color.Shadow">#000000</Color>
    <!-- Glass overlay colors (Themes/Glass.xaml reads these when Material is Mica or Acrylic). -->
    <Color x:Key="Glass.SurfaceColor">#2EFFFFFF</Color>
    <Color x:Key="Glass.ContentColor">#A61E2328</Color>
    <Color x:Key="Glass.WellColor">#26000000</Color>
    <Color x:Key="Glass.HairlineColor">#33FFFFFF</Color>
    <Color x:Key="Glass.EdgeTopColor">#66FFFFFF</Color>
    <Color x:Key="Glass.EdgeBottomColor">#14FFFFFF</Color>
</ResourceDictionary>
