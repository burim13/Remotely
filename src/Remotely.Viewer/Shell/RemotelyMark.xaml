<UserControl x:Class="Remotely.Viewer.Shell.RemotelyMark"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False">
    <!-- The Remotely mark on a 130-unit grid, drawn like Portico's: an amber monitor with a cream pointer. Vector, so it is crisp at any size. -->
    <UserControl.Resources>
        <LinearGradientBrush x:Key="Bezel" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FFD277" Offset="0" /><GradientStop Color="#D98A0E" Offset="1" /></LinearGradientBrush>
        <LinearGradientBrush x:Key="Pointer" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FFFBF0" Offset="0" /><GradientStop Color="#E8D6AE" Offset="1" /></LinearGradientBrush>
    </UserControl.Resources>
    <Viewbox Stretch="Uniform">
        <Canvas Width="130" Height="130">
            <Rectangle Canvas.Left="22" Canvas.Top="29" Width="86" Height="57" RadiusX="7" RadiusY="7" Fill="{StaticResource Bezel}" />
            <Rectangle Canvas.Left="27" Canvas.Top="34" Width="76" Height="46" RadiusX="3.5" RadiusY="3.5" Fill="#161A1E" />
            <Path Data="M57,95 L73,95 L76,97 L54,97 Z M56,86 L74,86 L76,97 L54,97 Z" Fill="#E09A1C" />
            <Rectangle Canvas.Left="47" Canvas.Top="95" Width="36" Height="7" RadiusX="3.3" RadiusY="3.3" Fill="#F2B134" />
            <Path Data="M55,42 L55,71 L63,64 L69,77 L76,74 L70,61 L81,61 Z" Fill="{StaticResource Pointer}" Stroke="#C9B58E" StrokeThickness="1.2" StrokeLineJoin="Round" />
        </Canvas>
    </Viewbox>
</UserControl>
