<Application x:Class="Remotely.Viewer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Dark.xaml" />
                <ResourceDictionary Source="Styles/Icons.xaml" />
                <ResourceDictionary Source="Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Same tokens as Portico's App.xaml: the type scale, radii and spacing every view maps to. -->
            <FontFamily x:Key="Font.Sans">pack://application:,,,/Fonts/#IBM Plex Sans, Segoe UI, Segoe UI Emoji, Segoe UI Symbol</FontFamily>
            <sys:Double x:Key="Text.Subject">17</sys:Double>
            <sys:Double x:Key="Text.Title">16</sys:Double>
            <sys:Double x:Key="Text.Body">14</sys:Double>
            <sys:Double x:Key="Text.Line">13</sys:Double>
            <sys:Double x:Key="Text.Secondary">12</sys:Double>
            <sys:Double x:Key="Text.Label">11</sys:Double>
            <CornerRadius x:Key="Radius.Panel">14</CornerRadius>
            <CornerRadius x:Key="Radius.Card">10</CornerRadius>
            <CornerRadius x:Key="Radius.Control">8</CornerRadius>
            <Thickness x:Key="Space.Side">16,0</Thickness>
            <sys:Double x:Key="Space.1">4</sys:Double>
            <sys:Double x:Key="Space.2">8</sys:Double>
            <sys:Double x:Key="Space.3">12</sys:Double>
            <sys:Double x:Key="Space.4">16</sys:Double>
            <sys:Double x:Key="Space.6">24</sys:Double>
            <Thickness x:Key="Row.Padding">16,9,16,10</Thickness>
        </ResourceDictionary>
    </Application.Resources>
</Application>
