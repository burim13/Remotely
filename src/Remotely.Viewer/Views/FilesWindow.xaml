<Window x:Class="Remotely.Viewer.Views.FilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shared files" Icon="/Assets/remotely.ico" Width="420" Height="420" WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Panel}" Foreground="{DynamicResource Brush.Text}" FontFamily="{DynamicResource Font.Sans}" FontSize="13"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="0" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Margin="16,0,6,0">
            <TextBlock Text="Shared files" FontSize="{DynamicResource Text.Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Style="{StaticResource IconButton}" Content="{StaticResource Icon.Close}" HorizontalAlignment="Right" AutomationProperties.Name="Close"
                    WindowChrome.IsHitTestVisibleInChrome="True" Click="OnCancel" />
        </Grid>
        <ScrollViewer Grid.Row="1" Style="{StaticResource ThinScrollViewer}" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="List">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource RowButton}" Padding="16,9" Tag="{Binding Name}" Click="OnPick" AutomationProperties.Name="{Binding Name}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" Foreground="{DynamicResource Brush.Secondary}" FontSize="{DynamicResource Text.Secondary}" />
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                            </DockPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <TextBlock Grid.Row="2" Margin="16,10" Text="Only files in the shared folder on that PC are listed." FontSize="{DynamicResource Text.Label}" Foreground="{DynamicResource Brush.Secondary}" />
    </Grid>
</Window>
