<Window x:Class="Remotely.Viewer.Views.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:Remotely.Viewer.Shell"
        Title="Remotely settings" Icon="/Assets/remotely.ico" Width="460" SizeToContent="Height" MinHeight="480"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Panel}" Foreground="{DynamicResource Brush.Text}"
        FontFamily="{DynamicResource Font.Sans}" FontSize="13"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="0" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Margin="16,0,6,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <shell:RemotelyMark Width="28" Height="28" />
                <TextBlock Text="Settings" Margin="10,0,0,0" FontSize="{DynamicResource Text.Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <Button Style="{StaticResource IconButton}" Content="{StaticResource Icon.Close}" HorizontalAlignment="Right" ToolTip="Close" AutomationProperties.Name="Close"
                    WindowChrome.IsHitTestVisibleInChrome="True" Click="OnClose" />
        </Grid>

        <StackPanel Grid.Row="1" Margin="16,0,16,16">
            <TextBlock Style="{StaticResource SectionLabel}" Text="YOUR SERVER" Margin="0,4,0,8" />
            <Border Style="{StaticResource Row}">
                <StackPanel>
                    <TextBlock Style="{StaticResource RowLabel}" Text="Invite" />
                    <TextBox x:Name="Invite" Style="{StaticResource TextField}" Margin="0,6,0,0" AutomationProperties.Name="Invite" />
                    <TextBlock Style="{StaticResource RowHelp}" Text="Paste the invite from your server's 'Remotely Server info'. It contains the address, the key and a one-time code." />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Row}">
                <StackPanel>
                    <TextBlock Style="{StaticResource RowLabel}" Text="This device's name" />
                    <TextBox x:Name="DeviceName" Style="{StaticResource TextField}" Margin="0,6,0,0" AutomationProperties.Name="This device's name" />
                </StackPanel>
            </Border>
            <Button x:Name="HandToggle" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,10,0,0" Content="Set up by hand instead" Click="OnToggleHand" />
            <StackPanel x:Name="HandPanel" Visibility="Collapsed">
                <Border Style="{StaticResource Row}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource RowLabel}" Text="Server address" />
                        <TextBox x:Name="Server" Style="{StaticResource TextField}" Margin="0,6,0,0" AutomationProperties.Name="Server address" />
                        <TextBlock Style="{StaticResource RowHelp}" Text="Looks like wss://your-name.example.com:8443/ws" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Row}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource RowLabel}" Text="Server key pin" />
                        <TextBox x:Name="Pin" Style="{StaticResource TextField}" Margin="0,6,0,0" AutomationProperties.Name="Server key pin" />
                    </StackPanel>
                </Border>
                <Border x:Name="CodeRow" Style="{StaticResource Row}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource RowLabel}" Text="Pairing code" />
                        <TextBox x:Name="Code" Style="{StaticResource TextField}" Margin="0,6,0,0" AutomationProperties.Name="Pairing code" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <TextBlock Style="{StaticResource SectionLabel}" Text="APPEARANCE" />
            <Border Style="{StaticResource Row}">
                <DockPanel>
                    <ComboBox x:Name="Theme" DockPanel.Dock="Right" Width="120" Style="{StaticResource DocketComboBox}" AutomationProperties.Name="Theme">
                        <ComboBoxItem Style="{StaticResource DocketComboBoxItem}" Content="Follow Windows" Tag="system" />
                        <ComboBoxItem Style="{StaticResource DocketComboBoxItem}" Content="Dark" Tag="dark" />
                        <ComboBoxItem Style="{StaticResource DocketComboBoxItem}" Content="Light" Tag="light" />
                    </ComboBox>
                    <TextBlock Style="{StaticResource RowLabel}" Text="Theme" />
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Row}">
                <CheckBox x:Name="SyncClipboard" Style="{StaticResource Switch}" Content="Share the clipboard in a session" />
            </Border>

            <TextBlock x:Name="Message" Margin="0,14,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
            <Border x:Name="IdCard" Visibility="Collapsed" Margin="0,12,0,0" Padding="12,10" CornerRadius="{StaticResource Radius.Card}" Background="{DynamicResource Brush.Surface}">
                <StackPanel>
                    <TextBlock Text="This device's id" FontWeight="SemiBold" />
                    <TextBlock x:Name="IdText" FontFamily="Consolas" FontSize="{DynamicResource Text.Secondary}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <TextBlock Style="{StaticResource RowHelp}" Text="Only needed if a computer you control is set to trust a list of ids instead of every device on your server." />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="CopyIdButton" Style="{StaticResource SecondaryButton}" Content="Copy my id" Margin="0,0,8,0" Click="OnCopyId" />
                <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}" Content="Save and connect" Click="OnSave" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
