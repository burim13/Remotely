<Window x:Class="Remotely.Viewer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:Remotely.Viewer.Shell"
        Title="Remotely" Icon="/Assets/remotely.ico" Width="440" Height="640" MinWidth="360" MinHeight="420"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Panel}" Foreground="{DynamicResource Brush.Text}"
        FontFamily="{DynamicResource Font.Sans}" FontSize="13"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType" UseLayoutRounding="True" SnapsToDevicePixels="True"
        AutomationProperties.Name="Remotely">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: the mark, the name, and the window buttons. -->
        <Grid Grid.Row="0" Margin="16,0,6,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <shell:RemotelyMark Width="28" Height="28" />
                <TextBlock Text="Remotely" Margin="10,0,0,0" FontSize="{DynamicResource Text.Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="RefreshButton" Style="{StaticResource IconButton}" Content="{StaticResource Icon.Refresh}" ToolTip="Refresh" AutomationProperties.Name="Refresh" Click="OnRefresh" />
                <Button Style="{StaticResource IconButton}" Content="{StaticResource Icon.Settings}" ToolTip="Settings" AutomationProperties.Name="Settings" Click="OnSettings" />
                <Button Style="{StaticResource IconButton}" Content="{StaticResource Icon.Minimize}" ToolTip="Minimise" AutomationProperties.Name="Minimise" Click="OnMinimize" />
                <Button Style="{StaticResource IconButton}" Content="{StaticResource Icon.Close}" ToolTip="Close" AutomationProperties.Name="Close" Click="OnClose" />
            </StackPanel>
        </Grid>

        <!-- Status banner: shown only when something needs attention. -->
        <Border x:Name="Banner" Grid.Row="1" Visibility="Collapsed" Margin="16,0,16,8" Padding="12,10" CornerRadius="{StaticResource Radius.Card}" Background="{DynamicResource Brush.Surface}">
            <DockPanel>
                <Button x:Name="BannerAction" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Try again" Margin="12,0,0,0" VerticalAlignment="Center" Click="OnRefresh" />
                <TextBlock x:Name="BannerText" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Error}" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- Your computers. -->
        <Grid Grid.Row="2">
            <ScrollViewer Style="{StaticResource ThinScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionLabel}" Text="YOUR COMPUTERS" Margin="16,8,16,8" />
                    <ItemsControl x:Name="Devices">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource RowButton}" Padding="16,10" Click="OnRowClick" Tag="{Binding}" IsEnabled="{Binding CanConnect}" Focusable="True"
                                        AutomationProperties.Name="{Binding Name}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="36" Height="36" CornerRadius="{StaticResource Radius.Control}" Background="{DynamicResource Brush.Surface}" VerticalAlignment="Center">
                                            <Viewbox Width="18" Height="18">
                                                <Path Width="24" Height="24" Data="{StaticResource Icon.Monitor}" Stroke="{DynamicResource Brush.Secondary}" StrokeThickness="2.2"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                            </Viewbox>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="{DynamicResource Text.Body}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Subtitle}" FontSize="{DynamicResource Text.Secondary}" Foreground="{DynamicResource Brush.Secondary}" Margin="0,1,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Connect" FontWeight="SemiBold" Foreground="{DynamicResource Brush.AccentText}" Visibility="{Binding ConnectVisibility}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="EmptyText" Visibility="Collapsed" Margin="16,16" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Secondary}"
                               Text="No computers yet. On each PC you want to reach, install Remotely Host and pair it with a code from your server." />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Footer: who am I. Click to copy the device id the host needs to trust. -->
        <Border Grid.Row="3" BorderBrush="{DynamicResource Brush.Hairline}" BorderThickness="0,1,0,0" Padding="16,10">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Content="{StaticResource Icon.Copy}" ToolTip="Copy this device's id" AutomationProperties.Name="Copy this device's id" Click="OnCopyId" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="ThisDevice" FontSize="{DynamicResource Text.Secondary}" Foreground="{DynamicResource Brush.Secondary}" />
                    <TextBlock Text="Connections go only through your own server." FontSize="{DynamicResource Text.Label}" Foreground="{DynamicResource Brush.Secondary}" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
