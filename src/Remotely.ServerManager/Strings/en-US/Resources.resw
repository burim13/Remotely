  <!-- Server Manager strings. Every user-visible string is a key here; no literals in XAML or code-behind. -->
  <data name="App_Name" xml:space="preserve"><value>Remotely Server Manager</value></data>
  <data name="Common_Cancel" xml:space="preserve"><value>Cancel</value></data>
