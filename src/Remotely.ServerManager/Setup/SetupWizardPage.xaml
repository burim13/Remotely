<Page x:Class="Remotely.ServerManager.Setup.SetupWizardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The steps are built in code (SetupWizardPage*.cs) so each one reads its strings from Resources.resw by key. -->
    <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="32,24,32,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock x:Name="StepText" Opacity="0.7" />
            <ProgressBar x:Name="Progress" Minimum="0" Maximum="1" Value="0" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid x:Name="StepHost" />
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button x:Name="BackButton" MinWidth="96" />
            <Button x:Name="NextButton" MinWidth="96" Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>
    </Grid>
</Page>
