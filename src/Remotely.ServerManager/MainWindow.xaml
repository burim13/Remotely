<Window x:Class="Remotely.ServerManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remotely Server Manager">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <InfoBar x:Name="ElevatedBar" Grid.Row="0" IsOpen="False" IsClosable="True" Severity="Warning" />
        <NavigationView x:Name="Nav" Grid.Row="1" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed" IsSettingsVisible="True"
                        OpenPaneLength="230" SelectionChanged="OnNavSelected" Background="Transparent"
                        AutomationProperties.LandmarkType="Navigation">
            <NavigationView.PaneHeader>
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="12,8,0,8">
                    <Image Source="ms-appx:///Assets/remotely-64.png" Width="28" Height="28" />
                    <TextBlock x:Name="PaneTitle" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </NavigationView.PaneHeader>
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NavDashboard" Tag="DashboardPage">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Home" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavInvite" Tag="InvitePage">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Add" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavDevices" Tag="DevicesPage">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="People" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavActivity" Tag="ActivityPage">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="List" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavService" Tag="ServicePage">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Repair" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <Frame x:Name="Pages" AutomationProperties.LandmarkType="Main" />
        </NavigationView>
    </Grid>
</Window>
