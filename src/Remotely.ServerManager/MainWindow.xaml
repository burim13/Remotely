<Window x:Class="Remotely.ServerManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remotely Server Manager">
    <!-- Skeleton: agent A11 builds the Dashboard, Invite, Devices, Activity and Settings pages here. -->
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <StackPanel Padding="32" Spacing="12" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Remotely Server Manager" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock x:Name="Info" Opacity="0.7" />
        </StackPanel>
    </Grid>
</Window>
