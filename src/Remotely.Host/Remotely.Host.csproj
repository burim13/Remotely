<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RootNamespace>Remotely.Host</RootNamespace>
    <AssemblyName>Remotely.Host</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Lets Linux/macOS build the Windows projects for compile checks; harmless on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- Agent A13: the pipe protocol is shared with the app (it lives in the app's Views/Unattended/Protocol folder, free of WinUI) so both ends use one definition. -->
    <Compile Include="..\Remotely.App\Views\Unattended\Protocol\*.cs" LinkBase="Unattended\Protocol" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Remotely.HostCore\Remotely.HostCore.csproj" />
    <ProjectReference Include="..\Remotely.HostWindows\Remotely.HostWindows.csproj" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
  </ItemGroup>

</Project>
