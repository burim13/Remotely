<UserControl x:Class="Remotely.App.Session.Files.TransfersPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Remotely.App.Session.Files">
    <UserControl.Resources>
        <DataTemplate x:Key="RowTemplate" x:DataType="local:TransferRowViewModel">
            <Grid Padding="12,10" ColumnSpacing="12" MinHeight="56">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="{x:Bind Glyph}" FontSize="18" VerticalAlignment="Top" Margin="0,2,0,0" />
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ProgressBar Value="{x:Bind Percent, Mode=OneWay}" Maximum="100" IsIndeterminate="{x:Bind IsIndeterminate, Mode=OneWay}"
                                 Visibility="{x:Bind ProgressVisibility, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind Detail, Mode=OneWay}" TextWrapping="Wrap" Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button Click="{x:Bind Retry}" Visibility="{x:Bind RetryVisibility, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind RetryLabel}" AutomationProperties.Name="{x:Bind RetryLabel}">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    </Button>
                    <Button Click="{x:Bind Reveal}" Visibility="{x:Bind RevealVisibility, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind RevealLabel}" AutomationProperties.Name="{x:Bind RevealLabel}">
                        <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                    </Button>
                    <Button Click="{x:Bind Cancel}" Visibility="{x:Bind CancelVisibility, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind CancelLabel}" AutomationProperties.Name="{x:Bind CancelLabel}">
                        <FontIcon Glyph="&#xE711;" FontSize="14" />
                    </Button>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="Root" Padding="16" RowSpacing="12" AllowDrop="True" Background="Transparent" DragOver="OnDragOver" Drop="OnDrop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="TitleText" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock x:Name="SummaryText" Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="SendFilesButton" Click="OnSendFiles">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE898;" FontSize="14" />
                        <TextBlock x:Name="SendFilesText" />
                    </StackPanel>
                </Button>
                <Button x:Name="SendFolderButton" Click="OnSendFolder">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                        <TextBlock x:Name="SendFolderText" />
                    </StackPanel>
                </Button>
                <Button x:Name="GetButton" Click="OnGetFiles">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE896;" FontSize="14" />
                        <TextBlock x:Name="GetText" />
                    </StackPanel>
                </Button>
                <Button x:Name="MoreButton">
                    <FontIcon Glyph="&#xE712;" FontSize="14" />
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem x:Name="OpenFolderItem" Click="OnOpenReceiveFolder" />
                            <MenuFlyoutItem x:Name="ChangeFolderItem" Click="OnChangeReceiveFolder" />
                            <MenuFlyoutItem x:Name="ClearItem" Click="OnClearFinished" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Padding="16" CornerRadius="8" BorderThickness="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <TextBlock x:Name="DropHint" TextWrapping="Wrap" HorizontalAlignment="Center" Opacity="0.7" />
        </Border>

        <Grid Grid.Row="2">
            <ListView x:Name="TransferList" SelectionMode="None" ItemTemplate="{StaticResource RowTemplate}" CanDragItems="True" DragItemsStarting="OnDragItemsStarting"
                      IsItemClickEnabled="False" />
            <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6" />
        </Grid>
    </Grid>
</UserControl>
