  <data name="Onboarding_Name_Body" xml:space="preserve"><value>Kështu shfaqet ky kompjuter te personat dhe pajisjet me të cilat lidheni. Mund ta ndryshoni më vonë te Cilësimet.</value></data>
  <data name="Onboarding_Name_Header" xml:space="preserve"><value>Emri i kompjuterit</value></data>
