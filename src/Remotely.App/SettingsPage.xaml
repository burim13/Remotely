<Page x:Class="Remotely.App.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      NavigationCacheMode="Required">
    <ScrollViewer>
        <StackPanel Padding="32,24" MaxWidth="640" HorizontalAlignment="Center" Spacing="16">
            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />

            <TextBox x:Name="DeviceName" Header="This PC's name" AutomationProperties.Name="This PC's name" />
            <ComboBox x:Name="Theme" Header="Appearance" MinWidth="200">
                <ComboBoxItem Content="Follow Windows" Tag="system" />
                <ComboBoxItem Content="Dark" Tag="dark" />
                <ComboBoxItem Content="Light" Tag="light" />
            </ComboBox>
            <ToggleSwitch x:Name="SyncClipboard" Header="Share the clipboard during a session" OnContent="On" OffContent="Off" />

            <TextBlock Text="Your server" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />
            <TextBlock x:Name="ServerState" TextWrapping="Wrap" Opacity="0.7" />
            <TextBox x:Name="Invite" Header="Invite from your server" PlaceholderText="RMT1-…  (leave empty to keep the current server)" AutomationProperties.Name="Invite" />
            <Expander Header="Set up by hand instead" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="10">
                    <TextBox x:Name="Server" Header="Server address" PlaceholderText="wss://server.example:8443" />
                    <TextBox x:Name="Pin" Header="Server key pin (64 characters)" />
                    <TextBox x:Name="Code" Header="Pairing code" PlaceholderText="ABCD-EFGH" />
                </StackPanel>
            </Expander>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="SaveButton" Content="Save" Style="{StaticResource AccentButtonStyle}" Click="OnSave" />
                <ProgressRing x:Name="Busy" IsActive="False" Width="24" Height="24" />
            </StackPanel>
            <InfoBar x:Name="Bar" IsOpen="False" IsClosable="False" />

            <TextBlock Text="This device" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />
            <TextBlock Text="A PC you reach through your server must trust this id. The installer does that for you." TextWrapping="Wrap" Opacity="0.7" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock x:Name="IdText" FontFamily="Cascadia Mono, Consolas" IsTextSelectionEnabled="True" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="480" />
                <Button Content="Copy" Click="OnCopyId" />
            </StackPanel>
            <TextBlock x:Name="VersionText" Opacity="0.5" Margin="0,12,0,0" />
        </StackPanel>
    </ScrollViewer>
</Page>
