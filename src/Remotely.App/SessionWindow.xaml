<Window x:Class="Remotely.App.SessionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Remotely.App"
        Title="Remotely">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <CommandBar DefaultLabelPosition="Right" Background="Transparent" IsOpen="False">
            <AppBarButton x:Name="UploadButton" Icon="Upload" Label="Send file" Click="OnUpload" IsEnabled="False" />
            <AppBarToggleButton x:Name="ClipboardButton" Icon="Paste" Label="Share clipboard" Click="OnClipboardToggle" IsEnabled="False" />
            <AppBarButton Icon="Cancel" Label="Disconnect" Click="OnDisconnect" />
        </CommandBar>
        <local:RemoteScreen x:Name="Screen" Grid.Row="1" />
        <Border x:Name="Overlay" Grid.Row="1" Visibility="Collapsed" Background="#CC000000">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
                <TextBlock x:Name="OverlayTitle" Foreground="White" FontSize="22" HorizontalAlignment="Center" />
                <TextBlock x:Name="OverlayText" Foreground="White" Opacity="0.8" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="480" />
                <Button Content="Close" HorizontalAlignment="Center" Click="OnDisconnect" />
            </StackPanel>
        </Border>
        <TextBlock x:Name="Status" Grid.Row="2" Margin="12,6" Opacity="0.7" />
    </Grid>
</Window>
