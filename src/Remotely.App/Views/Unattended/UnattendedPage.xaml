<Page x:Class="Remotely.App.Views.Unattended.UnattendedPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      NavigationCacheMode="Required">
    <ScrollViewer>
        <StackPanel Padding="32,24" MaxWidth="820" HorizontalAlignment="Center" Spacing="20">
            <TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock x:Name="IntroText" TextWrapping="Wrap" Opacity="0.7" />

            <InfoBar x:Name="LiveBar" IsOpen="True" IsClosable="False" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="UnattendedLiveStatus" />

            <Border Padding="24" CornerRadius="8" BorderThickness="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="ServiceTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="ServiceStateText" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.AutomationId="UnattendedServiceState" />
                    <TextBlock x:Name="ServiceHelp" TextWrapping="Wrap" Opacity="0.7" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="InstallButton" Style="{StaticResource AccentButtonStyle}" Click="OnInstall" AutomationProperties.AutomationId="UnattendedInstall" />
                        <Button x:Name="StartButton" Style="{StaticResource AccentButtonStyle}" Click="OnStart" AutomationProperties.AutomationId="UnattendedStart" />
                        <Button x:Name="StopButton" Click="OnStop" AutomationProperties.AutomationId="UnattendedStop" />
                        <Button x:Name="UninstallButton" Click="OnUninstall" AutomationProperties.AutomationId="UnattendedUninstall" />
                        <ProgressRing x:Name="Busy" IsActive="False" Width="24" Height="24" />
                    </StackPanel>
                    <InfoBar x:Name="ActionBar" IsOpen="False" IsClosable="True" />
                    <TextBlock x:Name="RecoveryText" TextWrapping="Wrap" Opacity="0.7" />
                </StackPanel>
            </Border>

            <Border Padding="24" CornerRadius="8" BorderThickness="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="LockTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="LockBody1" TextWrapping="Wrap" />
                    <TextBlock x:Name="LockBody2" TextWrapping="Wrap" />
                    <TextBlock x:Name="LockBody3" TextWrapping="Wrap" Opacity="0.7" />
                </StackPanel>
            </Border>

            <Border Padding="24" CornerRadius="8" BorderThickness="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="LanTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="LanHelp" TextWrapping="Wrap" Opacity="0.7" />
                    <TextBlock x:Name="LanNeedsService" TextWrapping="Wrap" FontWeight="SemiBold" />
                    <ToggleSwitch x:Name="LanAllowedSwitch" Toggled="OnLanAllowedToggled" AutomationProperties.AutomationId="UnattendedLanAllowed" />
                    <TextBlock x:Name="LanAllowedHelp" TextWrapping="Wrap" Opacity="0.7" Margin="0,-8,0,0" />
                    <ToggleSwitch x:Name="LanShareSwitch" Toggled="OnLanShareToggled" AutomationProperties.AutomationId="UnattendedLanShare" />
                    <StackPanel x:Name="TokenPanel" Spacing="10" Visibility="Collapsed">
                        <TextBlock x:Name="TokenLabel" Opacity="0.7" />
                        <TextBlock x:Name="TokenText" FontFamily="Cascadia Mono, Consolas" FontSize="38" FontWeight="SemiBold" IsTextSelectionEnabled="True" TextWrapping="NoWrap" />
                        <TextBlock x:Name="TokenInfo" Opacity="0.7" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="CopyButton" Click="OnCopyToken" />
                            <Button x:Name="NewTokenButton" Click="OnNewToken" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="SessionPanel" Orientation="Horizontal" Spacing="12" Visibility="Collapsed">
                        <TextBlock x:Name="SessionText" TextWrapping="Wrap" VerticalAlignment="Center" FontWeight="SemiBold" />
                        <Button x:Name="DisconnectButton" Click="OnDisconnect" />
                    </StackPanel>
                    <ToggleSwitch x:Name="AskSwitch" Toggled="OnAskToggled" AutomationProperties.AutomationId="UnattendedAsk" />
                    <TextBlock x:Name="AskHelp" TextWrapping="Wrap" Opacity="0.7" Margin="0,-8,0,0" />
                    <InfoBar x:Name="LanBar" IsOpen="False" IsClosable="True" />
                </StackPanel>
            </Border>

            <Border Padding="24" CornerRadius="8" BorderThickness="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="SasTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="SasHelp" TextWrapping="Wrap" Opacity="0.7" />
                    <ToggleSwitch x:Name="SasSwitch" Toggled="OnSasToggled" AutomationProperties.AutomationId="UnattendedSas" />
                    <TextBlock x:Name="SasState" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Padding="24" CornerRadius="8" BorderThickness="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="AwakeTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="AwakeHelp" TextWrapping="Wrap" Opacity="0.7" />
                    <ToggleSwitch x:Name="AwakeSwitch" Toggled="OnAwakeToggled" AutomationProperties.AutomationId="UnattendedAwake" />
                    <TextBlock x:Name="AwakeState" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
