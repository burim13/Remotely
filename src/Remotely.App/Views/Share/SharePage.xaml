<Page x:Class="Remotely.App.Views.Share.SharePage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Remotely.App.Views.Share"
        NavigationCacheMode="Required">
    <ScrollViewer>
        <StackPanel Padding="32,24" MaxWidth="820" HorizontalAlignment="Center" Spacing="20">
            <local:ShareCard />

            <Border Padding="24" CornerRadius="8" BorderThickness="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="RememberedTitle" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                        <Button x:Name="RemoveAllButton" Grid.Column="1" Click="OnRemoveAll" />
                    </Grid>
                    <TextBlock x:Name="RememberedHelp" TextWrapping="Wrap" Opacity="0.7" />
                    <TextBlock x:Name="RememberedEmpty" TextWrapping="Wrap" />
                    <StackPanel x:Name="RememberedList" Spacing="8" />
                </StackPanel>
            </Border>

            <Border Padding="24" CornerRadius="8" BorderThickness="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="HistoryTitle" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                        <Button x:Name="ClearHistoryButton" Grid.Column="1" Click="OnClearHistory" />
                    </Grid>
                    <TextBlock x:Name="HistoryEmpty" TextWrapping="Wrap" />
                    <StackPanel x:Name="HistoryList" Spacing="10" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
