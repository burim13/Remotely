<Window x:Class="Remotely.App.Views.Share.SessionBannerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remotely">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="6" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border x:Name="ActiveStrip" Background="{ThemeResource SystemFillColorCriticalBrush}" />
        <Border x:Name="PausedStrip" Background="{ThemeResource SystemFillColorCautionBrush}" Visibility="Collapsed" />
        <Grid Grid.Row="1" Padding="16,10" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock x:Name="Headline" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="Detail" Opacity="0.75" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="PauseButton" Click="OnPause" />
                <Button x:Name="StopButton" Style="{StaticResource AccentButtonStyle}" Click="OnStop" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
