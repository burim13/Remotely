<Page x:Class="Remotely.App.Views.Gallery.GalleryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:gallery="using:Remotely.App.Views.Gallery">
    <!-- Debug page: open it with: Remotely.exe, argument show, then GalleryPage. Dark and light side by side; high contrast follows the Windows setting. -->
    <ScrollViewer HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <gallery:GalleryPanel RequestedTheme="Dark" />
            <gallery:GalleryPanel Grid.Column="1" RequestedTheme="Light" />
        </Grid>
    </ScrollViewer>
</Page>
