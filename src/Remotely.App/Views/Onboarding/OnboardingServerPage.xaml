<Page x:Class="Remotely.App.Views.Onboarding.OnboardingServerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="32,24" MaxWidth="640" HorizontalAlignment="Stretch" Spacing="16">
            <TextBlock x:Name="Heading" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" />
            <TextBlock x:Name="Body" TextWrapping="Wrap" Opacity="0.8" />
            <TextBox x:Name="InviteBox" />
            <ProgressRing x:Name="Busy" IsActive="False" Width="24" Height="24" HorizontalAlignment="Left" />
            <InfoBar x:Name="Bar" IsOpen="False" IsClosable="False" />
        </StackPanel>
    </ScrollViewer>
</Page>
