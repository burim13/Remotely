<Page x:Class="Remotely.App.Views.Onboarding.OnboardingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Padding="32,16,32,0" Spacing="8" MaxWidth="640" HorizontalAlignment="Stretch">
            <TextBlock x:Name="StepText" Opacity="0.7" />
            <ProgressBar x:Name="Progress" Minimum="0" Maximum="1" Value="0" />
        </StackPanel>

        <Frame x:Name="StepFrame" Grid.Row="1" />

        <Grid Grid.Row="2" Padding="32,12,32,24" MaxWidth="640" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton" Grid.Column="0" Click="OnBack" HorizontalAlignment="Left" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                <Button x:Name="SkipButton" Click="OnSkip" />
                <Button x:Name="NextButton" Click="OnNext" Style="{StaticResource AccentButtonStyle}" MinWidth="96" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
