<Page x:Class="Remotely.App.Views.Onboarding.OnboardingDonePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="32,24" MaxWidth="640" HorizontalAlignment="Stretch" Spacing="16">
            <TextBlock x:Name="Heading" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" />
            <TextBlock x:Name="Body" TextWrapping="Wrap" Opacity="0.8" />
            <StackPanel x:Name="Summary" Spacing="4" />
            <CheckBox x:Name="StartWithWindows" />
            <CheckBox x:Name="CloseToTray" />
            <InfoBar x:Name="Bar" IsOpen="False" IsClosable="False" Severity="Warning" />
        </StackPanel>
    </ScrollViewer>
</Page>
