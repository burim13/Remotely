<UserControl x:Class="Remotely.App.Views.Connect.ConnectCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded" Unloaded="OnUnloaded">
    <Border Padding="24" CornerRadius="8" BorderThickness="1"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
        <StackPanel Spacing="14">
            <TextBlock x:Name="TitleText" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock x:Name="IntroText" TextWrapping="Wrap" Opacity="0.7" />

            <StackPanel Spacing="4">
                <TextBox x:Name="TokenBox" PlaceholderText="ABCD-EFGH-JKLM" FontFamily="Cascadia Mono, Consolas" FontSize="24"
                         CharacterCasing="Upper" MaxLength="20" TextChanged="OnTokenChanged" KeyDown="OnTokenKeyDown" />
                <TextBlock x:Name="HintError" Visibility="Collapsed" TextWrapping="Wrap"
                           Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                <TextBlock x:Name="HintInfo" Visibility="Collapsed" TextWrapping="Wrap" Opacity="0.7" />
            </StackPanel>

            <!-- PCs that are sharing on this network right now: name, public label and a lock. The token is still needed. -->
            <StackPanel x:Name="NearbyPanel" Spacing="6">
                <TextBlock x:Name="NearbyTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock x:Name="NearbyStatus" TextWrapping="Wrap" Opacity="0.7" />
                <ListView x:Name="NearbyList" AutomationProperties.LabeledBy="{Binding ElementName=NearbyTitle}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnNearbyClick" MaxHeight="180" />
            </StackPanel>

            <Expander x:Name="AddressExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="6">
                    <TextBlock x:Name="AddressHelp" TextWrapping="Wrap" Opacity="0.7" />
                    <TextBox x:Name="AddressBox" PlaceholderText="192.168.1.20" />
                </StackPanel>
            </Expander>

            <StackPanel x:Name="RecentPanel" Spacing="6">
                <TextBlock x:Name="RecentTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock x:Name="RecentEmpty" TextWrapping="Wrap" Opacity="0.7" />
                <ListView x:Name="RecentList" AutomationProperties.LabeledBy="{Binding ElementName=RecentTitle}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnRecentClick" MaxHeight="200" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="ConnectButton" Style="{StaticResource AccentButtonStyle}" Click="OnConnect" />
                <Button x:Name="CancelButton" Visibility="Collapsed" Click="OnCancel" />
                <ProgressRing x:Name="Busy" IsActive="False" Width="24" Height="24" />
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap" Opacity="0.7" />
            </StackPanel>
            <InfoBar x:Name="ConnectBar" IsOpen="False" IsClosable="False" Severity="Error" />
        </StackPanel>
    </Border>
</UserControl>
