<Window x:Class="Remotely.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remotely">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <NavigationView x:Name="Nav" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed" IsSettingsVisible="True"
                        OpenPaneLength="220" SelectionChanged="OnNavSelected" Background="Transparent">
            <NavigationView.PaneHeader>
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="12,8,0,8">
                    <Image Source="ms-appx:///Assets/remotely-64.png" Width="28" Height="28" />
                    <TextBlock Text="Remotely" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </NavigationView.PaneHeader>
            <NavigationView.MenuItems>
                <NavigationViewItem Content="This network" Tag="home" AutomationProperties.Name="This network">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Home" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="My computers" Tag="computers" AutomationProperties.Name="My computers">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Remote" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <Frame x:Name="Pages" />
        </NavigationView>
    </Grid>
</Window>
