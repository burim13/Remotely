<Window x:Class="Remotely.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remotely">
    <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The whole strip is the drag region (SetTitleBar); Windows draws the caption buttons over its right end. -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="32" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,0,0,0" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/remotely-64.png" Width="16" Height="16" />
                <TextBlock x:Name="TitleText" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <NavigationView x:Name="Nav" Grid.Row="1" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed" IsSettingsVisible="True"
                        OpenPaneLength="220" SelectionChanged="OnNavSelected" Background="Transparent">
            <Frame x:Name="Pages" />
        </NavigationView>

        <Frame x:Name="OnboardingFrame" Grid.Row="1" Visibility="Collapsed" />

        <InfoBar x:Name="ToastBar" Grid.Row="1" IsOpen="False" IsClosable="True" Severity="Informational"
                 VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="16" MaxWidth="560" />
    </Grid>
</Window>
