<UserControl x:Class="Remotely.UI.Controls.InlineBanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Remotely.UI.Controls"
             IsTabStop="False">
    <Border x:Name="Root" BorderThickness="1" CornerRadius="{StaticResource Portico.Radius.Medium}" Padding="16,12,12,12"
            Background="{ThemeResource Portico.NeutralSurface}" BorderBrush="{ThemeResource Portico.PillStroke}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="KindStates">
                <VisualState x:Name="Neutral" />
                <VisualState x:Name="Info">
                    <VisualState.Setters>
                        <Setter Target="Root.Background" Value="{ThemeResource Portico.InfoSurface}" />
                        <Setter Target="Mark.Foreground" Value="{ThemeResource Portico.Info}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Connected">
                    <VisualState.Setters>
                        <Setter Target="Root.Background" Value="{ThemeResource Portico.ConnectedSurface}" />
                        <Setter Target="Mark.Foreground" Value="{ThemeResource Portico.Connected}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Warning">
                    <VisualState.Setters>
                        <Setter Target="Root.Background" Value="{ThemeResource Portico.WarningSurface}" />
                        <Setter Target="Mark.Foreground" Value="{ThemeResource Portico.Warning}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Error">
                    <VisualState.Setters>
                        <Setter Target="Root.Background" Value="{ThemeResource Portico.ErrorSurface}" />
                        <Setter Target="Mark.Foreground" Value="{ThemeResource Portico.Error}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <local:PorticoIcon x:Name="Mark" Size="20" VerticalAlignment="Top" Margin="0,1,0,0" Foreground="{ThemeResource Portico.NeutralText}" />
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Style="{StaticResource Portico.Text.BodyStrong}" Foreground="{ThemeResource Portico.Text}" />
                <TextBlock x:Name="MessageText" Style="{StaticResource Portico.Text.Body}" Foreground="{ThemeResource Portico.Text}" Visibility="Collapsed" />
            </StackPanel>
            <ContentPresenter x:Name="ActionHost" Grid.Column="2" VerticalAlignment="Center" />
            <Button x:Name="DismissButton" Grid.Column="3" Padding="6" MinWidth="0" MinHeight="0" VerticalAlignment="Top" Visibility="Collapsed" Click="OnDismiss">
                <local:PorticoIcon Glyph="Close" Size="12" Foreground="{ThemeResource Portico.Text}" />
            </Button>
        </Grid>
    </Border>
</UserControl>
