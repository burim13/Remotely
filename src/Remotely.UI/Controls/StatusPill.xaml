<UserControl x:Class="Remotely.UI.Controls.StatusPill"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Remotely.UI.Controls"
             IsTabStop="False">
    <Border x:Name="Root" BorderThickness="1" CornerRadius="{StaticResource Portico.Radius.Pill}" Padding="10,3,12,3"
            Background="{ThemeResource Portico.NeutralSurface}" BorderBrush="{ThemeResource Portico.PillStroke}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="KindStates">
                <VisualState x:Name="Neutral" />
                <VisualState x:Name="Connected">
                    <VisualState.Setters>
                        <Setter Target="Root.Background" Value="{ThemeResource Portico.ConnectedSurface}" />
                        <Setter Target="Label.Foreground" Value="{ThemeResource Portico.Connected}" />
                        <Setter Target="Mark.Foreground" Value="{ThemeResource Portico.Connected}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Info">
                    <VisualState.Setters>
                        <Setter Target="Root.Background" Value="{ThemeResource Portico.InfoSurface}" />
                        <Setter Target="Label.Foreground" Value="{ThemeResource Portico.Info}" />
                        <Setter Target="Mark.Foreground" Value="{ThemeResource Portico.Info}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Warning">
                    <VisualState.Setters>
                        <Setter Target="Root.Background" Value="{ThemeResource Portico.WarningSurface}" />
                        <Setter Target="Label.Foreground" Value="{ThemeResource Portico.Warning}" />
                        <Setter Target="Mark.Foreground" Value="{ThemeResource Portico.Warning}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Error">
                    <VisualState.Setters>
                        <Setter Target="Root.Background" Value="{ThemeResource Portico.ErrorSurface}" />
                        <Setter Target="Label.Foreground" Value="{ThemeResource Portico.Error}" />
                        <Setter Target="Mark.Foreground" Value="{ThemeResource Portico.Error}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <StackPanel Orientation="Horizontal" Spacing="6">
            <local:PorticoIcon x:Name="Mark" Size="14" VerticalAlignment="Center" Foreground="{ThemeResource Portico.NeutralText}" />
            <TextBlock x:Name="Label" Style="{StaticResource Portico.Text.Caption}" Foreground="{ThemeResource Portico.NeutralText}" FontWeight="Medium" VerticalAlignment="Center" TextWrapping="NoWrap" />
        </StackPanel>
    </Border>
</UserControl>
