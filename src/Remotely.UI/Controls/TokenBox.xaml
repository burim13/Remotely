<UserControl x:Class="Remotely.UI.Controls.TokenBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Remotely.UI.Controls"
             IsTabStop="False">
    <StackPanel x:Name="Root" Spacing="6">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ValidationStates">
                <VisualState x:Name="Valid" />
                <VisualState x:Name="Invalid">
                    <VisualState.Setters>
                        <Setter Target="Frame.BorderBrush" Value="{ThemeResource Portico.Error}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <TextBlock x:Name="HeaderText" Style="{StaticResource Portico.Text.BodyStrong}" Visibility="Collapsed" />
        <Border x:Name="Frame" HorizontalAlignment="Left" BorderThickness="2" BorderBrush="{ThemeResource Portico.PillStroke}" CornerRadius="{StaticResource Portico.Radius.Medium}" Padding="4">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBox x:Name="G0" TextAlignment="Center" FontFamily="{StaticResource Portico.FontMono}" FontSize="{StaticResource Portico.FontSize.BodyLarge}" />
                <TextBlock x:Name="S0" Style="{StaticResource Portico.Text.Secondary}" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                <TextBox x:Name="G1" TextAlignment="Center" FontFamily="{StaticResource Portico.FontMono}" FontSize="{StaticResource Portico.FontSize.BodyLarge}" />
                <TextBlock x:Name="S1" Style="{StaticResource Portico.Text.Secondary}" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                <TextBox x:Name="G2" TextAlignment="Center" FontFamily="{StaticResource Portico.FontMono}" FontSize="{StaticResource Portico.FontSize.BodyLarge}" />
                <TextBlock x:Name="S2" Style="{StaticResource Portico.Text.Secondary}" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                <TextBox x:Name="G3" TextAlignment="Center" FontFamily="{StaticResource Portico.FontMono}" FontSize="{StaticResource Portico.FontSize.BodyLarge}" />
            </StackPanel>
        </Border>
        <StackPanel x:Name="ErrorRow" Orientation="Horizontal" Spacing="6" Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive">
            <local:PorticoIcon Glyph="Error" Size="14" VerticalAlignment="Center" Foreground="{ThemeResource Portico.Error}" />
            <TextBlock x:Name="ErrorText" Style="{StaticResource Portico.Text.Body}" Foreground="{ThemeResource Portico.Error}" />
        </StackPanel>
    </StackPanel>
</UserControl>
