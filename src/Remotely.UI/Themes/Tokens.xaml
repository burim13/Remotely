<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Design tokens: the only place (with Portico.xaml) where colours are written down. Owned by agent A1. Contrast of every text/background pair is checked by tests/Remotely.Tests/DesignTokenTests.cs. -->

    <!-- Type -->
    <FontFamily x:Key="Portico.Font">ms-appx:///Assets/Fonts/#IBM Plex Sans, Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Portico.FontMono">Cascadia Mono, Consolas, Courier New</FontFamily>
    <x:Double x:Key="Portico.FontSize.Caption">12</x:Double>
    <x:Double x:Key="Portico.FontSize.Body">14</x:Double>
    <x:Double x:Key="Portico.FontSize.BodyLarge">16</x:Double>
    <x:Double x:Key="Portico.FontSize.Subtitle">20</x:Double>
    <x:Double x:Key="Portico.FontSize.Title">28</x:Double>
    <x:Double x:Key="Portico.FontSize.Display">40</x:Double>

    <!-- Spacing: 4 / 8 / 12 / 16 / 24 / 32 -->
    <x:Double x:Key="Portico.Space4">4</x:Double>
    <x:Double x:Key="Portico.Space8">8</x:Double>
    <x:Double x:Key="Portico.Space12">12</x:Double>
    <x:Double x:Key="Portico.Space16">16</x:Double>
    <x:Double x:Key="Portico.Space24">24</x:Double>
    <x:Double x:Key="Portico.Space32">32</x:Double>
    <Thickness x:Key="Portico.Pad.Card">16</Thickness>
    <Thickness x:Key="Portico.Pad.Page">32,24,32,24</Thickness>

    <!-- Radius -->
    <CornerRadius x:Key="Portico.Radius.Small">4</CornerRadius>
    <CornerRadius x:Key="Portico.Radius.Medium">8</CornerRadius>
    <CornerRadius x:Key="Portico.Radius.Large">12</CornerRadius>
    <CornerRadius x:Key="Portico.Radius.Pill">999</CornerRadius>

    <!-- Motion, in milliseconds. Remotely.UI.Motion turns these into zero when Windows "animation effects" is off. -->
    <x:Double x:Key="Portico.Motion.Fast">120</x:Double>
    <x:Double x:Key="Portico.Motion.Normal">200</x:Double>
    <x:Double x:Key="Portico.Motion.Slow">320</x:Double>

    <Style x:Key="Portico.Text.Display" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Portico.Font}" />
        <Setter Property="FontSize" Value="{StaticResource Portico.FontSize.Display}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource Portico.Text}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Portico.Text.Title" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Portico.Font}" />
        <Setter Property="FontSize" Value="{StaticResource Portico.FontSize.Title}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource Portico.Text}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Portico.Text.Subtitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Portico.Font}" />
        <Setter Property="FontSize" Value="{StaticResource Portico.FontSize.Subtitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource Portico.Text}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Portico.Text.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Portico.Font}" />
        <Setter Property="FontSize" Value="{StaticResource Portico.FontSize.Body}" />
        <Setter Property="Foreground" Value="{ThemeResource Portico.Text}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Portico.Text.BodyStrong" TargetType="TextBlock" BasedOn="{StaticResource Portico.Text.Body}">
        <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style x:Key="Portico.Text.Secondary" TargetType="TextBlock" BasedOn="{StaticResource Portico.Text.Body}">
        <Setter Property="Foreground" Value="{ThemeResource Portico.TextSecondary}" />
    </Style>
    <Style x:Key="Portico.Text.Caption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Portico.Font}" />
        <Setter Property="FontSize" Value="{StaticResource Portico.FontSize.Caption}" />
        <Setter Property="Foreground" Value="{ThemeResource Portico.TextTertiary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Portico.Text.Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Portico.FontMono}" />
        <Setter Property="FontSize" Value="{StaticResource Portico.FontSize.BodyLarge}" />
        <Setter Property="Foreground" Value="{ThemeResource Portico.Text}" />
    </Style>

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="Portico.Surface" Color="#1C2127" />
            <SolidColorBrush x:Key="Portico.Card" Color="#2B3239" />
            <SolidColorBrush x:Key="Portico.CardRaised" Color="#30373E" />
            <SolidColorBrush x:Key="Portico.CardStroke" Color="#3E4850" />
            <SolidColorBrush x:Key="Portico.Field" Color="#161A1E" />
            <SolidColorBrush x:Key="Portico.Text" Color="#F2F4F5" />
            <SolidColorBrush x:Key="Portico.TextSecondary" Color="#A9B3BA" />
            <SolidColorBrush x:Key="Portico.TextTertiary" Color="#98A3AB" />
            <SolidColorBrush x:Key="Portico.Accent" Color="#F7BE55" />
            <SolidColorBrush x:Key="Portico.AccentHover" Color="#F9CB74" />
            <SolidColorBrush x:Key="Portico.AccentPressed" Color="#E2A93B" />
            <SolidColorBrush x:Key="Portico.AccentText" Color="#F7BE55" />
            <SolidColorBrush x:Key="Portico.OnAccent" Color="#1E2328" />
            <SolidColorBrush x:Key="Portico.Connected" Color="#6FCF97" />
            <SolidColorBrush x:Key="Portico.Error" Color="#FF9B8A" />
            <SolidColorBrush x:Key="Portico.Warning" Color="#F7BE55" />
            <SolidColorBrush x:Key="Portico.Info" Color="#8EB8FF" />
            <SolidColorBrush x:Key="Portico.Offline" Color="#6B767F" />
            <SolidColorBrush x:Key="Portico.ConnectedSurface" Color="#1F3A2B" />
            <SolidColorBrush x:Key="Portico.ErrorSurface" Color="#432522" />
            <SolidColorBrush x:Key="Portico.WarningSurface" Color="#41330F" />
            <SolidColorBrush x:Key="Portico.InfoSurface" Color="#1E3150" />
            <SolidColorBrush x:Key="Portico.NeutralSurface" Color="#39424A" />
            <SolidColorBrush x:Key="Portico.NeutralText" Color="#C3CBD1" />
            <SolidColorBrush x:Key="Portico.PillStroke" Color="Transparent" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="Portico.Surface" Color="#F9FAFB" />
            <SolidColorBrush x:Key="Portico.Card" Color="#FFFFFF" />
            <SolidColorBrush x:Key="Portico.CardRaised" Color="#FFFFFF" />
            <SolidColorBrush x:Key="Portico.CardStroke" Color="#D5DADF" />
            <SolidColorBrush x:Key="Portico.Field" Color="#FFFFFF" />
            <SolidColorBrush x:Key="Portico.Text" Color="#1F2429" />
            <SolidColorBrush x:Key="Portico.TextSecondary" Color="#5F6A74" />
            <SolidColorBrush x:Key="Portico.TextTertiary" Color="#68737D" />
            <SolidColorBrush x:Key="Portico.Accent" Color="#E8A93A" />
            <SolidColorBrush x:Key="Portico.AccentHover" Color="#F0B54F" />
            <SolidColorBrush x:Key="Portico.AccentPressed" Color="#D3982F" />
            <SolidColorBrush x:Key="Portico.AccentText" Color="#8A5A00" />
            <SolidColorBrush x:Key="Portico.OnAccent" Color="#1E2328" />
            <SolidColorBrush x:Key="Portico.Connected" Color="#1B6E44" />
            <SolidColorBrush x:Key="Portico.Error" Color="#B3261E" />
            <SolidColorBrush x:Key="Portico.Warning" Color="#8A5A00" />
            <SolidColorBrush x:Key="Portico.Info" Color="#1F5FBF" />
            <SolidColorBrush x:Key="Portico.Offline" Color="#A3ACB4" />
            <SolidColorBrush x:Key="Portico.ConnectedSurface" Color="#DDF1E5" />
            <SolidColorBrush x:Key="Portico.ErrorSurface" Color="#FBE3E0" />
            <SolidColorBrush x:Key="Portico.WarningSurface" Color="#FBEBCB" />
            <SolidColorBrush x:Key="Portico.InfoSurface" Color="#DCE8FB" />
            <SolidColorBrush x:Key="Portico.NeutralSurface" Color="#E6EAED" />
            <SolidColorBrush x:Key="Portico.NeutralText" Color="#46515B" />
            <SolidColorBrush x:Key="Portico.PillStroke" Color="Transparent" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="Portico.Surface" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="Portico.Card" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="Portico.CardRaised" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="Portico.CardStroke" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="Portico.Field" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="Portico.Text" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="Portico.TextSecondary" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="Portico.TextTertiary" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="Portico.Accent" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="Portico.AccentHover" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="Portico.AccentPressed" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="Portico.AccentText" Color="{ThemeResource SystemColorHotlightColor}" />
            <SolidColorBrush x:Key="Portico.OnAccent" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="Portico.Connected" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="Portico.Error" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="Portico.Warning" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="Portico.Info" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="Portico.Offline" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="Portico.ConnectedSurface" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="Portico.ErrorSurface" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="Portico.WarningSurface" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="Portico.InfoSurface" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="Portico.NeutralSurface" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="Portico.NeutralText" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="Portico.PillStroke" Color="{ThemeResource SystemColorWindowTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
