<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Remotely.Core\Remotely.Core.csproj" />
    <ProjectReference Include="..\..\src\Remotely.Client\Remotely.Client.csproj" />
    <ProjectReference Include="..\..\src\Remotely.HostCore\Remotely.HostCore.csproj" />
    <ProjectReference Include="..\..\src\Remotely.ViewerCore\Remotely.ViewerCore.csproj" />
    <ProjectReference Include="..\..\src\Remotely.Server\Remotely.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pure text rules of the WinUI TokenBox, compiled here so they can be tested without Windows. -->
    <Compile Include="..\..\src\Remotely.UI\Controls\TokenFormat.cs" Link="Linked\TokenFormat.cs" />
    <!-- Agent A2: the app shell's UI-free logic (command line, window placement, navigation catalog, single instance) is compiled into the tests, since the WinUI app cannot be referenced from Linux. -->
    <Compile Include="..\..\src\Remotely.App\Shell\Core\*.cs" LinkBase="ShellCore" />
    <!-- Agent A13: unattended access. The pipe protocol and the logic of the host service (pipe rules, consent relay, power requests, token sharing), none of it Windows-only, compiled here so it can be tested on Linux. -->
    <Compile Include="..\..\src\Remotely.App\Views\Unattended\Protocol\*.cs" LinkBase="UnattendedProtocol" />
    <Compile Include="..\..\src\Remotely.Host\Unattended\Core\*.cs" LinkBase="UnattendedCore" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
